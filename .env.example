# ── InfiniteWorldAI server environment ──
# Set these in Railway → your service → Variables tab.

# FREE AI for all visitors (recommended). Get a free key at console.groq.com (no card).
# This powers the character creator + companion at $0 — shared across visitors.
GROQ_API_KEY=

# Optional extra free providers (auto-fallback if Groq rate-limits):
GOOGLE_AI_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=

# Optional paid voice (ElevenLabs). Leave blank → browser Web Speech is used (free).
ELEVENLABS_API_KEY=

# Optional realistic 3D character generation (paid per-gen). Leave blank → preset/procedural.
MESHY_API_KEY=

# ── Accounts (optional but recommended) ──
# Password to view your private user log at /admin. Change this from the default!
ADMIN_PASSWORD=015060
# Secret used to sign login tokens. Set any long random string in production.
TOKEN_SECRET=change-me-to-a-long-random-string
