# Multi-stage Docker image for Infiniteworlds.
# Build the client → bundle into the server image → expose both.

# ── Stage 1: build client static bundle ────────────────────────────
FROM node:22-alpine AS client-builder
WORKDIR /app/client
COPY client/package*.json ./
RUN npm install --no-audit --no-fund
COPY client/ ./
RUN npm run build

# ── Stage 2: server runtime ────────────────────────────────────────
FROM node:22-alpine AS runtime
WORKDIR /app

# Server deps + source
COPY server/package*.json ./server/
RUN cd server && npm install --omit=dev --no-audit --no-fund
COPY server/ ./server/

# Drop the built client into a sibling dir the server can statically serve
COPY --from=client-builder /app/client/dist ./client-dist
COPY .env.example ./

# DB data lives in a volume
RUN mkdir -p /app/data && chown -R node:node /app

ENV NODE_ENV=production
ENV PORT=3001
EXPOSE 3001

USER node
CMD ["node", "server/index.js"]
